# Copy this file to .env and fill in values for YOUR environment.
# .env is git-ignored. Never commit real endpoints, IDs, or keys.

# --- Claims Operations API (tools/main.py) -----------------------------------
# Public HTTPS base URL where the Claims Operations API is deployed. Written into
# the `servers` entry of /openapi.json so a cloud-hosted agent can call it.
# Foundry calls OpenAPI tools from the cloud, so localhost will NOT work for an agent.
TOOLS_API_PUBLIC_URL=

# Optional: directory containing the synthetic data files. Defaults to ./data.
CLAIMS_DATA_DIR=

# Optional, for demos and tests only: simulate an outage. Comma-separated
# operationIds (for example get_claim,get_policy) or "all". Matching operations
# return the SERVICE_UNAVAILABLE error. Leave empty for normal operation.
CLAIMS_API_SIMULATE_OUTAGE=

# --- Microsoft Foundry (agent/, evaluation/) ----------------------------------
# Foundry project endpoint, for example https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=
# Model deployment name in that project (the demo was validated with gpt-6.1-sol).
FOUNDRY_MODEL_DEPLOYMENT_NAME=
# Public HTTPS base URL of the deployed Claims Operations API (scripts/deploy_tools.py --update-env writes it).
TOOLS_API_BASE_URL=

# --- Contoso Claims Review application (webapp/) ------------------------------
# The application also uses FOUNDRY_PROJECT_ENDPOINT above and your Azure CLI sign-in.
# Optional: agent name. Defaults to contoso-claims-review-agent.
FOUNDRY_AGENT_NAME=
# Optional: agent version to invoke. Defaults to the version recorded by agent/create_agent.py
# in .foundry-state.json, then to the latest version in Foundry. The validated demo baseline is
# version 3 (demo/baseline.json); scripts/validate_demo.py reports any other version as not ready.
FOUNDRY_AGENT_VERSION=
# Optional: seconds to wait for one agent turn (default 180).
CLAIMS_REVIEW_TURN_TIMEOUT_SECONDS=
# Optional: claim opened by default (default CLM-10482).
CLAIMS_REVIEW_DEFAULT_CLAIM=
# Optional: Claims Operations API used for the workspace's display facts. Defaults to TOOLS_API_BASE_URL;
# when both are empty the same API code runs in-process over the synthetic data.
CLAIMS_API_BASE_URL=
# Optional: server log folder (default webapp/.logs, git-ignored).
CLAIMS_REVIEW_LOG_DIR=

# --- Deployment of the Claims Operations API (scripts/deploy_tools.py) -------
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=
TOOLS_CONTAINER_APP_NAME=
