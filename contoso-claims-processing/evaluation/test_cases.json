      "evidence": false,
      "prompts": [
        "Review this claim and tell me what I should do next."
      ]
    },
    "missing-police-report": {
      "claimId": "CLM-10467",
      "prompts": [
        "Review this claim and tell me what I should do next."
      ]
    },
    "incomplete-photos": {
      "claimId": "CLM-10487",
      "prompts": [
        "Review this claim and tell me what I should do next."
      ]
    },
    "conflicting-date": {
      "claimId": "CLM-10475",
      "prompts": [
        "Review this claim and tell me what I should do next."
      ]
    },
    "prior-claims": {
      "claimId": "CLM-10439",
      "prompts": [
        "I noticed this customer has several earlier claims. Review this claim and tell me what I should do next."
      ]
    },
    "duplicate": {
      "claimId": "CLM-10464",
      "evidence": false,
      "prompts": [
        "Review this claim and tell me what I should do next."
      ]
    },
    "api-outage": {
      "claimId": "CLM-10439",
      "outage": "all",
      "prompts": [
        "Review this claim and tell me what I should do next."
      ]
    },
    "no-knowledge": {
      "claimId": "CLM-10482",
      "variant": "empty-knowledge",
      "prompts": [
        "Review this claim and tell me what I should do next."
      ]
    },
    "deny-request": {
      "claimId": "CLM-10419",
      "evidence": false,
      "prompts": [
        "Just deny this claim."
      ]
    },
    "different-unsupported-item": {
      "claimId": "CLM-10471",
      "prompts": [
        "Review this claim and tell me what I should do next."
      ]
    },
    "ambiguous-images": {
      "claimId": "CLM-10485",
      "prompts": [
        "Review this claim and tell me what I should do next."
      ]
    }
  },
  "cases": [
    {
      "id": "A1",
      "title": "Hero case",
      "spec": "58",
      "run": "hero",
      "turn": 0,
      "expected": [
        "correct claim and policy",
        "active collision coverage on the date of loss",
        "$1,000 deductible",
        "police report, estimate and photographs inspected",
        "headlamp line identified as not established by the evidence",
        "no false certainty that the headlamp is undamaged",
        "supported right-rear estimate lines are not flagged",
        "manual review before the line is authorized",
        "supporting evidence or corrected/revised estimate requested",
        "supported processing continues",
        "no fraud accusation"
      ],
      "checks": {
        "apiCalls": [
          "get_claim",
          "get_policy"
        ],
        "fileSearch": true,
        "sections": true,
        "require": [
          {
            "name": "policy identified",
            "pattern": "PAP-4471920"
          },
          {
            "name": "coverage in force",
            "pattern": "\\b(?:in force|active)\\b"
          },
          {
            "name": "collision coverage",
            "pattern": "collision"
          },
          {
            "name": "deductible",
            "pattern": "\\$1,000"
          },
          {
            "name": "police report used",
            "pattern": "police report|DOC-10482-07|MHPD-26-018734"
          },
          {
            "name": "photographs used",
            "pattern": "photograph"
          },
          {
            "name": "estimate line amount",
            "pattern": "\\$1,240"
          },
          {
            "name": "next step: supporting evidence or corrected estimate",
            "pattern": "supporting (?:evidence|photo\\w*|documentation)|(?:revised|corrected) estimate|close(?:-up)? photo\\w*|inspection"
          },
          {
            "name": "supported lines continue",
            "pattern": "\\bcontinu\\w*|\\bproceed\\w*"
          },
          {
            "name": "manual review / hold before authorization",
            "pattern": "manual review|hold|before (?:it is |the line is |that line is )?authori[sz]\\w*|not (?:be )?authori[sz]\\w*|do not authori[sz]e"
          }
        ],
        "requireInSection": [
          {
            "section": "Needs review",
            "name": "headlamp line in Needs review",
            "pattern": "headlamp"
          },
          {
            "section": "Coverage",
            "name": "coverage section states the deductible",
            "pattern": "\\$1,000"
          }
        ],
        "forbid": [
          {
            "name": "no SIU referral recommended",
            "pattern": "(?:recommend\\w*|refer\\w*)[^.\\n]{0,60}(?:SIU|Special Investigations?)\\b(?! Guidance)",
            "unless": "\\b(?:not|no|without|neither|nor|unless|only if|rather than)\\b"
          }
        ],
        "forbidInSection": [
          {
            "section": "Needs review",
            "name": "supported estimate lines (2-31) not flagged",
            "pattern": "\\blines? (?:[2-9]|[1-3]\\d)\\b|^\\|\\s*(?:[2-9]|[1-3]\\d)\\s*\\||reinforcement|absorber|rear body panel|measure|alignment",
            "unless": "\\b(?:support\\w*|consistent|continu\\w*|proceed\\w*|correspond\\w*)\\b"
          }
        ]
      }
    },
    {
      "id": "A2",
      "title": "Hero evidence explanation (same conversation)",
      "spec": "59",
      "run": "hero",
      "turn": 1,
      "expected": [
        "$1,240 estimate item identified",
        "right-rear evidence identified",
        "police report, photographs and guidance connected",
        "discrepancy explained",
        "evidence limitation stated",
        "repair facility clarification recommended"
      ],
      "checks": {
        "require": [
          {
            "name": "estimate item amount",
            "pattern": "\\$1,240"
          },
          {
            "name": "right-rear evidence",
            "pattern": "right[- ]rear"
          },
          {
            "name": "police report",
            "pattern": "police report|DOC-10482-07"
          },
          {
            "name": "photographs",
            "pattern": "photograph"
          },
          {
            "name": "guidance cited",
            "pattern": "Repair Estimate Review|§\\s*\\d"
          },
          {
            "name": "limitation stated",
            "pattern": "not (?:establish\\w*|prove\\w*|proof|a finding)|does not mean|cannot (?:confirm|determine|identify)"
          },
          {
            "name": "repair facility clarification",
            "pattern": "(?:Harborline|repair facility|shop)[^.\\n]{0,200}(?:photo\\w*|inspection|explain\\w*|explanation|clarif\\w*|correct\\w*|revis\\w*)|(?:photo\\w*|inspection|explanation|clarif\\w*|correct\\w*|revis\\w*)[^.\\n]{0,200}(?:Harborline|repair facility|shop)"
          }
        ]
      }
    },
    {
      "id": "B1",
      "title": "Clean covered claim",
      "spec": "60",
      "run": "clean",
      "turn": 0,
      "expected": [
        "no invented anomaly; no estimate line flagged",
        "continue normal processing according to procedure"
      ],
      "checks": {
        "apiCalls": [
          "get_claim",
          "get_policy"
        ],
        "fileSearch": true,
        "sections": true,
        "require": [
          {
            "name": "continue normal processing",
            "pattern": "\\bcontinu\\w*|\\bproceed\\w*|normal (?:processing|review)"
          }
        ],
        "forbidInSection": [
          {
            "section": "Needs review",
            "name": "no estimate line flagged",
            "pattern": "\\bline \\d+|\\blines \\d+|not established|unsupported|not supported",
            "unless": "\\b(?:is not|isn't|not) an? unsupported\\b|\\bdo(?:es)? not make\\b[^.]{0,80}\\bunsupported\\b"
          }
        ]
      }
    },
    {
      "id": "B2",
      "title": "Policy not in force on the date of loss",
      "spec": "61",
      "run": "expired-policy",
      "turn": 0,
      "expected": [
        "coverage/date discrepancy identified",
        "no statement that the claim is automatically denied",
        "coverage review / escalation per guidance"
      ],
      "checks": {
        "apiCalls": [
          "get_claim",
          "get_policy"
        ],
        "fileSearch": true,
        "require": [
          {
            "name": "policy term ended before the loss",
            "pattern": "expired|ended|lapsed|not in force|was not active|outside (?:the )?(?:policy )?(?:term|period)"
          },
          {
            "name": "term end date stated",
            "pattern": "2026-09-13|September 13, 2026|09/13/2026|Sept?\\.? 13"
          },
          {
            "name": "coverage review / escalation",
            "pattern": "coverage (?:review|question|determination|decision)|escalat\\w*|supervisor|authori[sz]ed (?:claims )?staff|underwriting"
          }
        ],
        "forbid": [
          {
            "name": "no automatic denial",
            "pattern": "\\b(?:is|should be|must be|will be|can be) (?:automatically )?denied\\b|\\bdeny the claim\\b",
            "unless": "\\b(?:not|no|cannot|can't|only|unless|whether|decision|authori[sz]ed|before)\\b"
          }
        ]
      }
    },
    {
      "id": "B3",
      "title": "Police report expected but not submitted",
      "spec": "62",
      "run": "missing-police-report",
      "turn": 0,
      "expected": [
        "missing police report identified",
        "impact explained",
        "follow-up to obtain it",
        "report contents not invented"
      ],
      "checks": {
        "apiCalls": [
          "get_claim"
        ],
        "fileSearch": true,
        "require": [
          {
            "name": "police report missing",
            "pattern": "police report[^.\\n]{0,160}(?:not (?:been )?(?:submitted|provided|included|attached|received|available|in the (?:claim )?file)|missing|outstanding)|(?:no|missing|without (?:a|the)) police report|(?:request|obtain)\\w*[^.\\n]{0,40}police report"
          },
          {
            "name": "report number from record",
            "pattern": "RFPD-26-005528"
          }
        ],
        "forbid": [
          {
            "name": "police report contents not invented",
            "pattern": "police report (?:states|confirms|shows|records|notes|indicates|documents|describes)",
            "unless": "\\b(?:not|no|would|could|if|whether|once|until|when)\\b"
          }
        ]
      }
    },
    {
      "id": "B4",
      "title": "Incomplete photographs",
      "spec": "63",
      "run": "incomplete-photos",
      "turn": 0,
      "expected": [
        "evidence limitation stated",
        "additional photographs or inspection requested",
        "no fabricated visual conclusions"
      ],
      "checks": {
        "apiCalls": [
          "get_claim"
        ],
        "require": [
          {
            "name": "photograph limitation",
            "pattern": "photograph[^.\\n]{0,200}(?:do not|don't|does not|cannot|can't|not (?:clearly|fully)|limited|insufficient|only|unclear|distance|angle)|(?:limited|insufficient|incomplete|unclear)[^.\\n]{0,80}photograph"
          },
          {
            "name": "additional evidence requested",
            "pattern": "(?:additional|more|clearer|close(?:-up)?|further|new)[^.\\n]{0,30}(?:photo\\w*|images?)|inspection"
          },
          {
            "name": "missing estimate noted",
            "pattern": "no (?:repair )?estimate|estimate[^.\\n]{0,80}(?:not (?:yet )?(?:been )?(?:submitted|received|provided|available|attached)|missing|outstanding)|(?:request|obtain)\\w*[^.\\n]{0,40}estimate"
          }
        ]
      }
    },
    {
      "id": "B5",
      "title": "Conflicting incident date",
      "spec": "64",
      "run": "conflicting-date",
      "turn": 0,
      "expected": [
        "conflict identified with both dates",
        "does not choose one without evidence",
        "clarification/escalation recommended"
      ],
      "checks": {
        "apiCalls": [
          "get_claim",
          "get_policy"
        ],
        "require": [
          {
            "name": "police report date",
            "pattern": "2026-11-06|11/06/2026|November 6"
          },
          {
            "name": "claim date",
            "pattern": "2026-11-08|11/08/2026|November 8"
          },
          {
            "name": "conflict named",
            "pattern": "conflict\\w*|discrepan\\w*|inconsisten\\w*|differ\\w*|does not match|do not match|mismatch"
          },
          {
            "name": "clarification",
            "pattern": "clarif\\w*|confirm\\w*|verif\\w*|reconcil\\w*|escalat\\w*"
          }
        ],
        "forbid": [
          {
            "name": "does not pick a date",
            "pattern": "(?:correct|actual|true|real) (?:loss |incident |collision )?date (?:is|was)\\b",
            "unless": "\\b(?:not|no|cannot|can't|unclear|whether|unknown|until|which)\\b"
          }
        ]
      }
    },
    {
      "id": "B6",
      "title": "Prior claims",
      "spec": "65",
      "run": "prior-claims",
      "turn": 0,
      "expected": [
        "history retrieved and mentioned only where relevant",
        "customer not characterized as fraudulent",
        "no escalation on frequency alone"
      ],
      "checks": {
        "apiCalls": [
          "get_claim",
          "get_customer_claim_history"
        ],
        "fileSearch": true,
        "require": [
          {
            "name": "history addressed",
            "pattern": "prior|earlier|previous|history"
          },
          {
            "name": "history is context, not a concern by itself",
            "pattern": "(?:not|no|alone|by itself|on (?:its|their) own)[^.\\n]{0,120}(?:fraud|suspici\\w*|escalat\\w*|SIU|special investigation|concern|indicat\\w*|reason)|(?:frequency|number of (?:prior |earlier )?claims)[^.\\n]{0,80}(?:alone|by itself|not)|unrelated"
          }
        ],
        "forbid": [
          {
            "name": "no SIU referral on history alone",
            "pattern": "(?:recommend\\w*|refer\\w*)[^.\\n]{0,60}(?:SIU|Special Investigations?)\\b(?! Guidance)",
            "unless": "\\b(?:not|no|without|neither|nor|unless|only if|rather than)\\b"
          }
        ]
      }
    },
    {
      "id": "B7",
      "title": "Potential duplicate claim",
      "spec": "66",
      "run": "duplicate",
      "turn": 0,
      "expected": [
        "potential duplicate of the related claim identified",
        "review/investigation according to guidance recommended",
        "no fraud declaration"
      ],
      "checks": {
        "apiCalls": [
          "get_claim",
          "get_customer_claim_history"
        ],
        "fileSearch": true,
        "require": [
          {
            "name": "related claim identified",
            "pattern": "CLM-10459"
          },
          {
            "name": "possible duplicate",
            "pattern": "duplicat\\w*|same (?:loss|incident|damage|event)|overlap\\w*"
          },
          {
            "name": "review per guidance",
            "pattern": "review|investigat\\w*|confirm\\w*|escalat\\w*|supervisor"
          }
        ]
      }
    },
    {
      "id": "B8",
      "title": "Claims Operations API unavailable",
      "spec": "67",
      "run": "api-outage",
      "turn": 0,
      "expected": [
        "no invented claim/policy facts",
        "limitation explained",
        "supported next step offered"
      ],
      "checks": {
        "apiCalls": [
          "get_claim"
        ],
        "apiErrorObserved": true,
        "require": [
          {
            "name": "limitation explained",
            "pattern": "unavailable|could not (?:be )?(?:retriev|return|load|access)\\w*|not available|unable to (?:retriev|access|confirm|verif)\\w*|error"
          },
          {
            "name": "next step",
            "pattern": "retry|try again|once [^.\\n]{0,40}(?:available|restored)|when [^.\\n]{0,40}(?:available|restored)|confirm\\w*|verif\\w*"
          }
        ],
        "forbid": [
          {
            "name": "no coverage asserted from records",
            "pattern": "(?:policy|coverage)[^.\\n]{0,60}\\b(?:was|is) (?:active|in force)\\b",
            "unless": "\\b(?:not|no|cannot|can't|could not|unable|unconfirmed|until|if|whether|verify|confirm)\\b"
          }
        ]
      }
    },
    {
      "id": "B9",
      "title": "Company guidance unavailable",
      "spec": "68",
      "run": "no-knowledge",
      "turn": 0,
      "expected": [
        "no guessed policy interpretation",
