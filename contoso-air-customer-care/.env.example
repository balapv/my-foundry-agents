# Copy this file to .env and fill in values for YOUR environment.
# .env is git-ignored. Never commit real endpoints, IDs, or keys.

# --- Microsoft Foundry -------------------------------------------------------
# Foundry project endpoint, from the project's Overview page in the Foundry portal.
# Format: https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_PROJECT_ENDPOINT=

# Name of the model deployment in your Foundry project that the agent uses.
FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini

# Agent name in Foundry. Must match the agent you create in the UI or with code.
# Allowed: letters, numbers, and hyphens; must start and end with a letter or number.
FOUNDRY_AGENT_NAME=contoso-air-customer-care

# Optional: agent version that clients (web app, evaluations) invoke. Foundry assigns version
# numbers; never hard-code one in source. When empty, clients use the activeAgentVersion that
# agent/create_agent.py records in .foundry-state.json, and otherwise the agent's latest version
# (for example, the version you saved last in the portal).
FOUNDRY_AGENT_VERSION=

# Optional: model deployment used as the LLM judge by evaluation/run_evaluation.py.
# Defaults to FOUNDRY_MODEL_DEPLOYMENT_NAME.
FOUNDRY_JUDGE_DEPLOYMENT_NAME=

# --- Mock airline tools API --------------------------------------------------
# Public HTTPS base URL of the deployed tools API (scripts/deploy_tools.py prints it).
# Foundry calls the OpenAPI tools from the cloud, so localhost will NOT work for the agent.
TOOLS_API_BASE_URL=

# Optional: pin the demo "today" (YYYY-MM-DD) and time of day (HH:MM). By default the
# tools API uses the current date and time in DEMO_TIMEZONE, so CT218 is always
# cancelled "tomorrow". DEMO_TIME decides which of today's flights have departed.
DEMO_TODAY=
DEMO_TIME=
DEMO_TIMEZONE=America/Los_Angeles

# --- Azure deployment of the tools API (scripts/deploy_tools.py) --------------
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=westus3
TOOLS_CONTAINER_APP_NAME=contoso-air-tools

# --- Sample web application --------------------------------------------------
# Simulated signed-in customer for the web app (demo only; no real sign-in).
DEMO_CUSTOMER_ID=CUST-1007

# Optional: maximum seconds the web app waits for one agent turn (default 180).
WEBAPP_TURN_TIMEOUT_SECONDS=
